# Build-time version stamp (issues 40/56): recomputed on every build so the binary always
# names the HEAD it was built from, not the HEAD of the last configure. The header is
# rewritten only when the stamp actually changes, so an unchanged stamp costs no relink.
# Inputs (via -D): TM_SOURCE_DIR, TM_FALLBACK_VERSION (the plain release version),
# TM_OUTPUT (the header to write). Without git, or outside a checkout, the plain version
# is stamped. Dirtiness counts tracked changes only (-uno): untracked scratch - a work
# tree's extra build directory, a bench/data symlink - must not brand a clean commit dirty.
set(_version "${TM_FALLBACK_VERSION}")
find_program(_git git)
if(_git AND EXISTS "${TM_SOURCE_DIR}/.git")
  execute_process(COMMAND ${_git} rev-parse --short HEAD
                  WORKING_DIRECTORY ${TM_SOURCE_DIR}
                  OUTPUT_VARIABLE _sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  execute_process(COMMAND ${_git} status --porcelain -uno
                  WORKING_DIRECTORY ${TM_SOURCE_DIR}
                  OUTPUT_VARIABLE _dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(_sha)
    set(_version "${TM_FALLBACK_VERSION}+${_sha}")
    if(_dirty)
      set(_version "${_version}-dirty")
    endif()
  endif()
endif()
set(_content "#pragma once\n// Generated by cmake/GitVersion.cmake at build time; do not edit.\n#define TM_VERSION \"${_version}\"\n")
set(_old "")
if(EXISTS "${TM_OUTPUT}")
  file(READ "${TM_OUTPUT}" _old)
endif()
if(NOT _old STREQUAL _content)
  file(WRITE "${TM_OUTPUT}" "${_content}")
endif()
